# Copy to .env.local to override for local development.

# Deployed telemetry worker. Defaults to https://telemetry.orbinum.io
VITE_API_BASE=http://localhost:8787
# To watch your own node, point this at your own worker (`pnpm dev:back`) and
# put that chain's genesis in the backend's TELEMETRY_CHAINS. There is no
# devnet tab: the deployed worker rejects chains outside its allowlist, and a
# --dev genesis changes on every restart.

# Genesis hashes. A network without one is hidden from the switcher; read the
# current value from a live node with chain_getBlockHash(0).
VITE_TESTNET_GENESIS=0x58e2de05e550e64bb73bb2aeb706431dae70dcd1b589d477033c6e3aef3680ae
VITE_MAINNET_GENESIS=
