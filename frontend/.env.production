# Telemetry worker endpoint used by production builds (Cloudflare Pages).
VITE_API_BASE=https://telemetry.orbinum.io

# A network is only offered once its genesis hash is set here — an
# unconfigured one would be a tab that can only ever fail, since the worker
# rejects chains outside its allowlist.
VITE_TESTNET_GENESIS=0x58e2de05e550e64bb73bb2aeb706431dae70dcd1b589d477033c6e3aef3680ae
# Fill in at mainnet launch.
VITE_MAINNET_GENESIS=
