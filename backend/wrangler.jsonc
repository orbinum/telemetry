/**
 * Orbinum Telemetry worker — node ingest (/submit) + browser feed (/feed).
 *
 * Rate-limiter namespace ids follow the org-wide allocation documented in
 * api-worker's wrangler.toml (1xxx api-worker, 2xxx/3xxx indexer, 4xxx
 * faucet, 5xxx public-sale); 6xxx is telemetry's block.
 *
 * There is deliberately no `env` block. Cloudflare environments do not inherit
 * top-level config, so a second one means redeclaring every binding and
 * risking a worker that silently ships without one; with a single deploy
 * target there is nothing to gain. `wrangler dev` overrides what it needs
 * through .dev.vars instead.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbinum-telemetry-back",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "routes": [
    {
      "pattern": "telemetry.orbinum.io",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAIN",
        "class_name": "ChainDO",
      },
      {
        "name": "GATEWAY",
        "class_name": "GatewayDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChainDO", "GatewayDO"],
    },
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "SUBMIT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "6001",
        "simple": {
          "limit": 20,
          "period": 60,
        },
      },
      {
        "name": "FEED_LIMITER",
        "type": "ratelimit",
        "namespace_id": "6002",
        "simple": {
          "limit": 60,
          "period": 60,
        },
      },
      {
        "name": "HISTORY_LIMITER",
        "type": "ratelimit",
        "namespace_id": "6003",
        "simple": {
          "limit": 60,
          "period": 60,
        },
      },
    ],
  },
  // Chain history. A separate database from api-worker's `orbinum` on purpose:
  // D1 executes serially per database, so sharing one would let a telemetry
  // write path stall the member API, and the reverse.
  //
  // The binding is optional in code (`env.DB` checked before use), so the
  // worker runs without it — history just stops being recorded.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbinum-telemetry",
      "database_id": "9d457af9-2b01-4fa5-9421-f5bc5c577595",
    },
  ],
  // Nightly rollup + prune. Deliberately not a DO alarm: this is
  // chain-independent maintenance and must not wake an object serving ingest.
  "triggers": {
    "crons": ["0 4 * * *"],
  },
  "vars": {
    "TELEMETRY_TESTNET_GENESIS": "0x58e2de05e550e64bb73bb2aeb706431dae70dcd1b589d477033c6e3aef3680ae",
    "TELEMETRY_MAINNET_GENESIS": "",
    "TELEMETRY_CHAINS": "",
  },
  "upload_source_maps": true,
}
